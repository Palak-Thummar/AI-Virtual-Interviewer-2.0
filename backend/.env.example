# ==============================================================
# CareerIQ Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ==============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=CareerIQ
APP_VERSION=1.0.0
DEBUG=false

# ── Database ─────────────────────────────────────────────────
# MongoDB connection string
# Local:      mongodb://localhost:27017
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net
DATABASE_URL=mongodb://localhost:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=ai_interviewer

# ── JWT Authentication ────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_STRONG_RANDOM_VALUE
SECRET_KEY=CHANGE_ME_USE_STRONG_RANDOM_VALUE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI / OpenRouter ───────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b:free
COACH_MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b:free

# ── Judge0 (optional – for code execution grading) ───────────
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGIN_REGEX=

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ── SMTP (optional – for email notifications) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_FILE_SIZE=10485760

# CORS Origins
CORS_ORIGINS=https://ai-virtual-interviewer-2-0.vercel.app
